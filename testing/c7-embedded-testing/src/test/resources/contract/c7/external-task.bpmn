<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="c7-contract">
  <bpmn:process id="contract-external-task" name="Process worker request" isExecutable="true" camunda:historyTimeToLive="1"><bpmn:startEvent id="start" name="Work requested"><bpmn:outgoing>toWorker</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="worker" name="Process request" camunda:type="external" camunda:topic="contract-worker"><bpmn:incoming>toWorker</bpmn:incoming><bpmn:outgoing>toEnd</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end" name="Work completed"><bpmn:incoming>toEnd</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="toWorker" sourceRef="start" targetRef="worker"/><bpmn:sequenceFlow id="toEnd" sourceRef="worker" targetRef="end"/></bpmn:process>
  <bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="contract-external-task"><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="80" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="worker_di" bpmnElement="worker"><dc:Bounds x="180" y="98" width="100" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="350" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="toWorker_di" bpmnElement="toWorker"><di:waypoint x="116" y="138"/><di:waypoint x="180" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="toEnd_di" bpmnElement="toEnd"><di:waypoint x="280" y="138"/><di:waypoint x="350" y="138"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>