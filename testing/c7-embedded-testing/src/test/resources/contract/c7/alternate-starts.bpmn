<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="c7-contract" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:message id="startMessage" name="contract.start" />
  <bpmn:process id="contract-alternate-starts" name="Approve started request" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:startEvent id="normalStart" name="Request created">
      <bpmn:outgoing>normalToHold</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="normalHold" name="Review request">
      <bpmn:incoming>normalToHold</bpmn:incoming>
      <bpmn:outgoing>normalToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="normalEnd" name="Request reviewed">
      <bpmn:incoming>normalToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="messageStart" name="Start message received">
      <bpmn:outgoing>messageToApproval</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="startMessage" />
    </bpmn:startEvent>
    <bpmn:userTask id="approval" name="Approve request">
      <bpmn:incoming>messageToApproval</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Request approved">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="normalToHold" sourceRef="normalStart" targetRef="normalHold" />
    <bpmn:sequenceFlow id="normalToEnd" sourceRef="normalHold" targetRef="normalEnd" />
    <bpmn:sequenceFlow id="messageToApproval" sourceRef="messageStart" targetRef="approval" />
    <bpmn:sequenceFlow id="toEnd" sourceRef="approval" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="contract-alternate-starts">
      <bpmndi:BPMNShape id="normal_di" bpmnElement="normalStart">
        <dc:Bounds x="180" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="116" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="normalHold_di" bpmnElement="normalHold">
        <dc:Bounds x="280" y="58" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="normalEnd_di" bpmnElement="normalEnd">
        <dc:Bounds x="450" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="424" y="116" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="message_di" bpmnElement="messageStart">
        <dc:Bounds x="180" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="163" y="258" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval_di" bpmnElement="approval">
        <dc:Bounds x="280" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="450" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="423" y="273" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="normalToHold_di" bpmnElement="normalToHold">
        <di:waypoint x="216" y="98" />
        <di:waypoint x="280" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="normalToEnd_di" bpmnElement="normalToEnd">
        <di:waypoint x="380" y="98" />
        <di:waypoint x="450" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="messageToApproval_di" bpmnElement="messageToApproval">
        <di:waypoint x="216" y="240" />
        <di:waypoint x="280" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toEnd_di" bpmnElement="toEnd">
        <di:waypoint x="380" y="240" />
        <di:waypoint x="450" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
