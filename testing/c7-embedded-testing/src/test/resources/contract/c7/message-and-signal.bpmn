<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="c7-contract"><bpmn:message id="message" name="contract.continue"/><bpmn:signal id="signal" name="contract.continue.signal"/>
  <bpmn:process id="contract-message-and-signal" name="Continue customer request" isExecutable="true" camunda:historyTimeToLive="1"><bpmn:startEvent id="start" name="Request received"><bpmn:outgoing>toMessage</bpmn:outgoing></bpmn:startEvent><bpmn:intermediateCatchEvent id="messageWait" name="Continuation message awaited"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="correlationKey">customer-42</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>toMessage</bpmn:incoming><bpmn:outgoing>toSignal</bpmn:outgoing><bpmn:messageEventDefinition messageRef="message"/></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="signalWait" name="Continuation signal awaited"><bpmn:incoming>toSignal</bpmn:incoming><bpmn:outgoing>toEnd</bpmn:outgoing><bpmn:signalEventDefinition signalRef="signal"/></bpmn:intermediateCatchEvent><bpmn:endEvent id="end" name="Request continued"><bpmn:incoming>toEnd</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="toMessage" sourceRef="start" targetRef="messageWait"/><bpmn:sequenceFlow id="toSignal" sourceRef="messageWait" targetRef="signalWait"/><bpmn:sequenceFlow id="toEnd" sourceRef="signalWait" targetRef="end"/></bpmn:process>
  <bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="contract-message-and-signal"><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="60" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="message_di" bpmnElement="messageWait"><dc:Bounds x="150" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="signal_di" bpmnElement="signalWait"><dc:Bounds x="250" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="350" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="toMessage_di" bpmnElement="toMessage"><di:waypoint x="96" y="138"/><di:waypoint x="150" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="toSignal_di" bpmnElement="toSignal"><di:waypoint x="186" y="138"/><di:waypoint x="250" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="toEnd_di" bpmnElement="toEnd"><di:waypoint x="286" y="138"/><di:waypoint x="350" y="138"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>